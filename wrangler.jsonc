{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akkord-game",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "akkord-game.voelkslieder.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
